<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <!--set
  debug revit version and constants-->
  <PropertyGroup Condition="$(Configuration.StartsWith('Debug'))">
    <RevitVersion>$(Configuration.Replace("Debug",""))</RevitVersion>
    <DefineConstants>$(DefineConstants);Debug</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration)=='Release'">
    <DefineConstants>$(DefineConstants);Release</DefineConstants>
    <CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)'==''">2020</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>
  <!--debug
  action,for revit version < 2019, use "debug-attach to process" to debug -->
  <PropertyGroup Condition=" '$(Configuration)' != 'Release' ">
    <StartAction Condition="$(RevitVersion) &lt;= '2018'">Project</StartAction>
    <StartAction Condition="$(RevitVersion) &gt;'2018'">Program</StartAction>
    <StartProgram Condition="$(RevitVersion)&gt;'2018'"
      >C:/Program Files/Autodesk/Revit
      $(RevitVersion)/Revit.exe</StartProgram
    >
  </PropertyGroup>
  <!--TargetFramework-->
  <PropertyGroup>
    <TargetFramework Condition="$(RevitVersion) &lt;= '2024'">net48</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) == '2025'">net8.0-windows</TargetFramework>
  </PropertyGroup>
  <!--output
  path-->
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <IntermediateOutputPath>$(SolutionDir)obj/$(MSBuildProjectName)/revit$(RevitVersion)/</IntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(SolutionDir)obj/$(MSBuildProjectName)/revit$(RevitVersion)/</MSBuildProjectExtensionsPath>
    <OutputPath>$(SolutionDir)bin/$(MSBuildProjectName)/revit$(RevitVersion)/</OutputPath>
  </PropertyGroup>
  <!--packages-->
  <ItemGroup>
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="$(RevitVersion).*">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ZLinq" Version="1.5.2" />
  </ItemGroup>
</Project>
