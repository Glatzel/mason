<Project>
  <PropertyGroup>
    <Version>0.0.1</Version>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <AnalysisLevel>latest-Recommended</AnalysisLevel>
    <CSharpier_LogLevel>Warning</CSharpier_LogLevel>
    <Configurations>
      Release;Debug2018;Debug2019;Debug2020;Debug2021;Debug2022;Debug2023;Debug2024;Debug2025
    </Configurations>
  </PropertyGroup>
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)'==''">2020</RevitVersion>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
  </PropertyGroup>
  <!--debug
  action,for revit version < 2019, use "debug-attach to process" to debug -->
  <PropertyGroup Condition=" '$(Configuration)' != 'Release' ">
    <StartAction Condition="$(RevitVersion) &lt;= '2018'">Project</StartAction>
    <StartAction Condition="$(RevitVersion) &gt;'2018'">Program</StartAction>
    <StartProgram Condition="$(RevitVersion)&gt;'2018'">C:/Program Files/Autodesk/Revit
      $(RevitVersion)/Revit.exe</StartProgram>
  </PropertyGroup>
  <!--TargetFramework-->
  <PropertyGroup>
    <TargetFramework Condition="$(RevitVersion) &lt;= '2024'">net48</TargetFramework>
    <TargetFramework Condition="$(RevitVersion) == '2025'">net8.0-windows</TargetFramework>
  </PropertyGroup>
  <!--packages-->
  <ItemGroup>
    <PackageReference Include="NLog" Version="6.0.4" />
  </ItemGroup>
  <!--analyser-->
  <ItemGroup>
    <PackageReference Include="CSharpier.MsBuild" Version="1.1.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.CodeAnalysis.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Formatting.Analyzers" Version="4.14.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>